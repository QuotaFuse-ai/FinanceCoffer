# FinanceCoffer configuration template.
# Copy to .env (gitignored) and fill in real values.
# Precedence: built-in defaults -> .env -> process environment -> explicit CLI/library overrides.
# Only FC_* variables are read; empty values mean "unset" and keep the default.
# Never put real credentials in this file.
#
# The five credential fields below may hold a *reference* instead of a literal,
# and the value is then resolved at load time, before validation:
#   keyring:<service>/<account>  OS credential store (Windows Credential Manager
#                                built in; macOS/Linux need financecoffer[keyring])
#   file:<path>                  one secret per file (optional DPAPI blob on Windows)
#   env:<VAR>                    explicit fallback: the value stays in the environment
# Anything else is the literal secret, so a plain postgresql:// DSN keeps working.
# Store a secret and get its reference with `fcoffer config secret set <field>`;
# an unresolvable reference is a hard E_CONFIG failure, never an empty value.

# PostgreSQL DSN (ODS/DWD/DWS/vector schemas live here)
# Either a literal DSN, or a reference such as file:/etc/financecoffer/db_url.txt
FC_DB_URL=postgresql+psycopg://financecoffer:CHANGE_ME@127.0.0.1:5432/financecoffer

# Embedding service (DEC-0005: local bge-m3, 1024 dims, OpenAI-compatible endpoint)
FC_EMBEDDING_PROVIDER=local
FC_EMBEDDING_MODEL=BAAI/bge-m3
FC_EMBEDDING_DIM=1024
FC_EMBEDDING_URL=http://127.0.0.1:8080/v1/embeddings
# Reference example: env:FC_EMBEDDING_KEY
FC_EMBEDDING_API_KEY=

# Object storage for cold data and large documents
FC_MINIO_ENDPOINT=127.0.0.1:9000
# Reference examples: keyring:financecoffer/minio_access_key, file:/etc/financecoffer/minio_secret.txt
FC_MINIO_ACCESS_KEY=
FC_MINIO_SECRET_KEY=
FC_MINIO_BUCKET=financecoffer

# Event ingestion (upstream TickHub standard events)
FC_EVENT_CONSUMER=redis
FC_REDIS_URL=redis://127.0.0.1:6379/1
FC_EVENT_STREAM=fc:stockdata:events
FC_EVENT_GROUP=fc-etl

# MCP HTTP bearer token; required before exposing `fcoffer mcp http` beyond loopback
FC_MCP_TOKEN=

# REST request limiting (in-process token bucket per client IP; /health and /metrics exempt)
# Set FC_RATE_LIMIT_ENABLED=false to disable; FC_RATE_LIMIT_PER_MINUTE must be 1..10000.
FC_RATE_LIMIT_ENABLED=true
FC_RATE_LIMIT_PER_MINUTE=120

# Logging (CRITICAL / ERROR / WARNING / INFO / DEBUG)
FC_LOG_LEVEL=INFO

# Cold-data threshold in years before text/PDF moves to MinIO
FC_COLD_AFTER_YEARS=3
