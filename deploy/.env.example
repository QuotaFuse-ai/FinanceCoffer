# FinanceCoffer deployment template.
#
# Copy to deploy/.env (gitignored) and fill in the credentials and the
# deployment identity (role, database name, DSN) - the values only the operator
# can supply. Everything else already carries a working default: enums,
# booleans, integers and plain names mirroring
# src/financecoffer/core/config.py, so no enum, boolean or integer can trip
# E_CONFIG. The credentials ship empty on purpose, because this file is
# published as-is and an empty value is not a value. Copying it verbatim still
# cannot boot: compose.yaml marks the required keys `${VAR:?}`, so
# `docker compose` refuses to render while they are empty, and the application
# reports E_CONFIG when the DSN is unset. The file feeds
# `docker compose --env-file deploy/.env`.
#
# Application variable names match src/financecoffer/core/config.py exactly.
# Empty values mean "unset" (the built-in default applies); missing values make
# compose fail loudly. Two credentials are legitimately empty in some
# deployments - `FC_EMBEDDING_API_KEY` under the local provider and
# `FC_MCP_TOKEN` on loopback-only hosts - so read the note next to each one.

# --- Compose-only: database bootstrap -------------------------------------
# Credentials for the postgres service itself; the application DSN is built
# from these three values by compose.yaml. The user and database names are the
# operator's choice, the password is a real secret. All three are `${VAR:?}` in
# compose.yaml, so leaving them empty stops `docker compose` with a message
# naming the key.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- Application configuration -------------------------------------------
# PostgreSQL DSN. Compose rebuilds it from the POSTGRES_* values above, so this
# entry only matters when the same .env is used outside compose. It carries the
# password and is therefore left to the operator; unset, the application
# reports E_CONFIG instead of guessing a database.
FC_DB_URL=

# Event ingestion and cache. FC_REDIS_URL may carry a password, so it is left
# empty; inside compose the redis service is reached through the override in
# compose.yaml, outside compose an empty value falls back to the built-in
# default. The names below are plain defaults.
FC_REDIS_URL=
# redis (default implementation) | kafka | webhook
FC_EVENT_CONSUMER=redis
FC_EVENT_STREAM=fc:stockdata:events
FC_EVENT_GROUP=fc-etl

# ETL consumer tuning: queue names, retry budget and stale-entry recovery.
# Leave FC_ETL_CONSUMER_NAME empty so the consumer uses its hostname and
# reclaims its own pending entries after a restart.
FC_ETL_CONSUMER_NAME=
FC_ETL_DLQ_STREAM=fc:stockdata:dlq
FC_ETL_CONTROL_KEY=fc:etl:control
FC_ETL_BATCH_SIZE=50
FC_ETL_BLOCK_MS=5000
FC_ETL_MAX_ATTEMPTS=3
FC_ETL_BACKOFF_MS=1000
FC_ETL_CLAIM_IDLE_MS=60000

# Embedding endpoint (OpenAI-compatible; 1024 dimensions for bge-m3).
# local | openai. The URL is not a compose service: under compose it must name
# a host reachable from the containers, and host.docker.internal is the
# documented hop to an embedding server on the Docker host.
FC_EMBEDDING_PROVIDER=local
FC_EMBEDDING_MODEL=BAAI/bge-m3
FC_EMBEDDING_DIM=1024
FC_EMBEDDING_URL=http://host.docker.internal:8080/v1/embeddings
# Only required when FC_EMBEDDING_PROVIDER=openai; unused by the local provider,
# so blank is the correct value there.
FC_EMBEDDING_API_KEY=

# Object storage. The compose MinIO service takes its root credentials from
# these two values; FC_MINIO_ENDPOINT is overridden inside the network. The
# endpoint below is the host-side default used outside compose. Both keys are
# `${VAR:?}` in compose.yaml, so empty stops `docker compose` by name.
FC_MINIO_ENDPOINT=127.0.0.1:9000
FC_MINIO_ACCESS_KEY=
FC_MINIO_SECRET_KEY=
FC_MINIO_BUCKET=financecoffer

# Compliance marking switch and REST rate limiting.
FC_COMPLIANCE_ENABLED=false
FC_RATE_LIMIT_ENABLED=true
FC_RATE_LIMIT_PER_MINUTE=120

# MCP bearer token. Blank means "no token": only acceptable on a loopback-only
# host. Any deployment reachable from another machine must fill it.
FC_MCP_TOKEN=

# Logging and cold-data retention. Log level is one of
# CRITICAL | ERROR | WARNING | INFO | DEBUG.
FC_LOG_LEVEL=INFO
FC_COLD_AFTER_YEARS=3
