# FinanceCoffer deployment template.
#
# Copy to deploy/.env (gitignored) and replace every CHANGE_ME placeholder.
# The file feeds `docker compose --env-file deploy/.env`; nothing here is
# committed with real values.
#
# Application variable names match src/financecoffer/core/config.py exactly.
# Empty values mean "unset"; missing values make compose fail loudly.

# --- Compose-only: database bootstrap -------------------------------------
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=CHANGE_ME

# --- Application configuration -------------------------------------------
# PostgreSQL DSN. Compose rebuilds it from the POSTGRES_* values above, so this
# entry only matters when the same .env is used outside compose.
FC_DB_URL=CHANGE_ME

# Event ingestion and cache.
FC_REDIS_URL=CHANGE_ME
FC_EVENT_CONSUMER=CHANGE_ME
FC_EVENT_STREAM=CHANGE_ME
FC_EVENT_GROUP=CHANGE_ME

# Embedding endpoint (OpenAI-compatible; 1024 dimensions for bge-m3).
# Compose keeps this value as-is, so it must be reachable from the containers.
FC_EMBEDDING_PROVIDER=CHANGE_ME
FC_EMBEDDING_MODEL=CHANGE_ME
FC_EMBEDDING_DIM=CHANGE_ME
FC_EMBEDDING_URL=CHANGE_ME
FC_EMBEDDING_API_KEY=CHANGE_ME

# Object storage. The compose MinIO service takes its root credentials from
# these two values; FC_MINIO_ENDPOINT is overridden inside the network.
FC_MINIO_ENDPOINT=CHANGE_ME
FC_MINIO_ACCESS_KEY=CHANGE_ME
FC_MINIO_SECRET_KEY=CHANGE_ME
FC_MINIO_BUCKET=CHANGE_ME

# Compliance marking switch and REST rate limiting.
FC_COMPLIANCE_ENABLED=CHANGE_ME
FC_RATE_LIMIT_ENABLED=CHANGE_ME
FC_RATE_LIMIT_PER_MINUTE=CHANGE_ME

# MCP bearer token (leave empty only for loopback-only deployments).
FC_MCP_TOKEN=CHANGE_ME

# Logging and cold-data retention.
FC_LOG_LEVEL=CHANGE_ME
FC_COLD_AFTER_YEARS=CHANGE_ME
